rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed data model:
    // users/{uid}/schedules/{scheduleId}: uid, title, date, time, endTime,
    //   location, category, createdAt, updatedAt.
    // users/{uid}/tasks/{taskId}: uid, title, date, priority, completed,
    //   createdAt, updatedAt, kind, time, reminderEnabled.
    // Documents are private to their signed-in owner. Timestamps are written
    // with serverTimestamp(); createdAt cannot be changed after creation.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner(data) {
      return isAuthenticated() && data.uid == request.auth.uid;
    }

    function uidUnchanged() {
      return isAuthenticated() &&
        'uid' in request.resource.data &&
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return isAuthenticated() &&
        'uid' in request.resource.data &&
        request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function isValidDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isValidSchedule(data) {
      return data.keys().hasAll([
          'uid', 'title', 'date', 'time', 'endTime', 'location', 'category',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'title', 'date', 'time', 'endTime', 'location', 'category',
          'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 80 &&
        isValidDate(data.date) && isValidTime(data.time) && isValidTime(data.endTime) &&
        data.endTime > data.time &&
        data.location is string && data.location.size() <= 160 &&
        data.category in ['work', 'life', 'focus'] &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidTask(data) {
      return data.keys().hasAll([
          'uid', 'title', 'date', 'priority', 'completed', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'title', 'date', 'priority', 'completed', 'createdAt', 'updatedAt',
          'kind', 'time', 'reminderEnabled'
        ]) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
        isValidDate(data.date) &&
        data.priority in ['一般', '高優先'] && data.completed is bool &&
        (!('kind' in data) || data.kind in ['task', 'reminder']) &&
        (!('time' in data) || isValidTime(data.time)) &&
        (!('reminderEnabled' in data) || data.reminderEnabled is bool) &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /users/{userId}/schedules/{scheduleId} {
      allow get, list: if isOwner(userId) && isDocOwner(resource.data);
      allow create: if isOwner(userId) && uidUnchanged() &&
        isDocOwner(request.resource.data) && isValidSchedule(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId) && uidNotModified() &&
        isDocOwner(resource.data) && isDocOwner(request.resource.data) &&
        isValidSchedule(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(userId) && isDocOwner(resource.data);
    }

    match /users/{userId}/tasks/{taskId} {
      allow get, list: if isOwner(userId) && isDocOwner(resource.data);
      allow create: if isOwner(userId) && uidUnchanged() &&
        isDocOwner(request.resource.data) && isValidTask(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId) && uidNotModified() &&
        isDocOwner(resource.data) && isDocOwner(request.resource.data) &&
        isValidTask(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(userId) && isDocOwner(resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
